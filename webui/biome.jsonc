{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "root": ".." },
  "files": {
    "includes": ["**", "!**/dist", "!**/test-results", "!**/src/generated", "!**/*.tsbuildinfo"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "semicolons": "asNeeded", "quoteStyle": "double" } },
  "plugins": [
    {
      "path": "./biome-plugins/raw-text-box.grit",
      // Only `TextBox` itself and tests may draw a raw text box.
      "includes": ["**", "!**/src/ui/text-box/**", "!**/*.test.ts", "!**/*.test.tsx"]
    }
  ],
  "linter": {
    "enabled": true,
    "domains": { "react": "recommended", "test": "recommended" },
    "rules": {
      "preset": "recommended",
      "correctness": {
        // `useLatest` returns a ref that never changes identity, so it is not a dependency.
        "useExhaustiveDependencies": {
          "level": "error",
          "options": { "hooks": [{ "name": "useLatest", "stableResult": true }] }
        }
      },
      "style": {
        // Off on purpose: the code uses `!` where a value is known to exist, and tsc already checks the rest.
        "noNonNullAssertion": "off"
      }
    }
  },
  "assist": { "enabled": false }
}
