language js(jsx)

or { `<textarea $props />`, `<chakra.textarea $props />`, `<Textarea $props />`, `<input $props />`, `<chakra.input $props />`, `<Input $props />` } as $el where {
  not $props <: contains or { `type="file"`, `type="hidden"`, `type="checkbox"`, `type="radio"` },
  not $props <: contains r"data-focus-ring.*",
  register_diagnostic(span=$el, message="R4 text box without data-focus-ring.", severity="error")
}
