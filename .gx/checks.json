{
  "setup": ["pnpm -C webui exec playwright install chromium webkit"],
  "lint": {
    "changed": "go run . brief -C webui biome",
    "full": "go run . brief -C webui biome"
  },
  "guards": {
    "full": "gx brief go-test ./sleepguard ./envguard ./oldwords ./playwrightguard ./sizeguard ./setstateguard",
    "changed": "gx brief go-test -run '^TestNoNewSleeps$' ./sleepguard",
    "always": [
      { "command": "gx brief go-test -run '^TestNoEnvReads$' ./envguard", "files": ["**/*.go"] },
      "gx brief go-test -run '^TestNoOldWords$' ./oldwords",
      { "command": "gx brief go-test ./playwrightguard", "files": ["webui/**"] },
      { "command": "gx brief go-test ./sizeguard", "files": ["**/*.go"] },
      { "command": "gx brief go-test ./setstateguard", "files": ["**/*.go"] }
    ]
  },
  "test": {
    "full": "GX_TEST_E2E=1 scripts/test.sh",
    "always": [
      "gx brief go-test -run '^TestSchemaSnapshot$' ./migrations"
    ],
    "limits": {
      "suite": "10m",
      "hang": "60s",
      "slow": { "go": "20s", "vitest": "20s", "playwright": "45s" }
    }
  }
}
