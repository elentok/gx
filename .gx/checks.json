{
  "test": {
    "full": "GX_TEST_E2E=1 scripts/test.sh",
    "always": [
      "gx brief go-test -run '^TestNoNewSleeps$' ./sleepguard",
      "gx brief go-test -run '^TestNoEnvReads$' ./envguard",
      "gx brief go-test -run '^TestNoOldWords$' ./oldwords",
      "gx brief go-test -run '^TestRepoFlowsReadStateAfterExpect$' ./playwrightguard",
      "gx brief go-test -run '^TestSchemaSnapshot$' ./migrations"
    ],
    "limits": {
      "suite": "10m",
      "hang": "60s",
      "slow": { "go": "20s", "vitest": "20s", "playwright": "45s" }
    }
  }
}
